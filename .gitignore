.env

# الداتا الخام (عشان حجمها كبير ومبنرفعش داتا على GitHub)
data/raw/*
!data/raw/.gitkeep

# Processed Data (Nadeen)
data/processed/*
!data/processed/.gitkeep

# ملفات قاعدة بيانات Airflow المحلية (لو شغلتها بره Docker)
airflow.db
webserver_config.py

# ملفات بايثون المؤقتة
__pycache__/
*.py[cod]
venv/
.venv/

# ملفات الـ IDE
.vscode/
.idea/


# ملفات سجلات Airflow
logs/
*.log