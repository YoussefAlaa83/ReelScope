# Copy this file to .env and replace all example values with your credentials.
TMDB_API_KEY=replace_with_tmdb_api_key
# Comma-separated keys are rotated by the OMDb extractor.
OMDB_API_KEYS=replace_with_omdb_key_1,replace_with_omdb_key_2

# SQL Server connection
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=Film_DWH
DB_DRIVER=ODBC Driver 17 for SQL Server
# For SQL authentication, set both values and DB_TRUSTED_CONNECTION=false.
DB_USER=
DB_PASSWORD=
# Set true for Windows integrated authentication; false for SQL authentication.
DB_TRUSTED_CONNECTION=true

# Optional: DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO

# Optional extraction settings (defaults: 2000 movies, 15-second requests).
TMDB_MAX_MOVIES=2000
REQUEST_TIMEOUT=15
